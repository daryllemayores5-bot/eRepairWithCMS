APP_NAME=eRepair
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
FRONTEND_URL=http://127.0.0.1:5173

# UTC storage; business display is Asia/Manila (config/erepair.php).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erepair
DB_USERNAME=erepair
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
MAIL_MAILER=log
MAIL_TIMEOUT=15
MAIL_REQUIRE_TLS=false
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME=eRepair

# Automatic city-level technician map references (no private addresses sent).
# The bundled catalog works offline; unlisted towns use this optional lookup.
GEOCODING_ENABLED=true
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
GEOCODING_API_KEY=

# Optional free Render + Vercel profile; see docs/render-vercel.md.
EREPAIR_DURABLE_FILES=false
EREPAIR_SINGLE_INSTANCE=false
EREPAIR_FILE_QUOTA_MB=128
EREPAIR_DEPLOYMENT_TARGET=
BREVO_API_KEY=

# Statamic Core: one CMS editor, independent of marketplace users.
STATAMIC_PRO_ENABLED=false
STATAMIC_LICENSE_KEY=
STATAMIC_IMPERSONATE_ENABLED=false
