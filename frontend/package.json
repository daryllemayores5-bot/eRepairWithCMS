{
  "name": "erepair-frontend-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:production": "node scripts/build-production.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:rules": "node --experimental-strip-types --test ../tests/repair-request.test.mts ../tests/worker-retirement.test.mjs",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:live-api": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "axios": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0",
    "vue": "^3.5.43",
    "vue-router": "^4.0.0",
    "pinia": "^3.0.0",
    "@tanstack/vue-query": "^5.0.0",
    "@tanstack/query-core": "^5.0.0",
    "lucide-vue-next": "^0.577.0",
    "vue-sonner": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/leaflet": "^1.9.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "vue-tsc": "^3.0.0",
    "typescript": "^5.9.3",
    "@vue/test-utils": "^2.0.0",
    "@testing-library/vue": "^8.0.0"
  }
}
