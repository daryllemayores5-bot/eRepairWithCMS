# Browser requests use the Vite proxy locally and same-origin paths in production.
VITE_API_URL=/api/v1
# Server-side development proxy target; never put secrets in VITE_ variables.
BACKEND_URL=http://127.0.0.1:8000
# Optional absolute backend origin for the administrator CP link in development.
# For a same-origin production build, leave this empty. This is not a secret.
VITE_BACKEND_PUBLIC_URL=http://127.0.0.1:8000
